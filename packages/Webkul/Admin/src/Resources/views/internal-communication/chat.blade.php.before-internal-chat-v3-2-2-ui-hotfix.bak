        Internal Chat
    </x-slot>

    @php
        $currentUser = auth()->guard('user')->user();

        $lastMessageId =
            $messages->isNotEmpty()
                ? $messages->max('id')
                : 0;

        $makeInitials = function ($value) {
            $parts = preg_split('/\s+/', trim((string) $value)) ?: [];
            $initials = '';

            foreach (array_slice($parts, 0, 2) as $part) {
                $initials .= strtoupper(mb_substr($part, 0, 1));
            }

            return $initials ?: 'U';
        };
    @endphp

